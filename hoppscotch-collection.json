{
  "v": 8,
  "name": "Home Inventory API",
  "folders": [],
  "requests": [
    {
      "v": "8",
      "endpoint": "<<SUPABASE_URL>>/auth/v1/token?grant_type=password",
      "name": "Login to Supabase",
      "params": [
        {
          "key": "grant_type",
          "value": "password",
          "active": true
        }
      ],
      "headers": [
        {
          "key": "apikey",
          "value": "<<SUPABASE_ANON_KEY>>",
          "active": true
        },
        {
          "key": "Content-Type",
          "value": "application/json",
          "active": true
        }
      ],
      "method": "POST",
      "auth": {
        "authType": "none",
        "authActive": true
      },
      "preRequestScript": "",
      "testScript": "pw.env.set(\"ACCESS_TOKEN\", pw.response.body.access_token);",
      "body": {
        "contentType": "application/json",
        "body": "{\n  \"email\": \"<<USER_EMAIL>>\",\n  \"password\": \"<<USER_PASSWORD>>\"\n}"
      },
      "description": "Authenticates the user and sets the ACCESS_TOKEN environment variable in Hoppscotch."
    },
    {
      "v": "8",
      "endpoint": "http://localhost:8080/api/v1/homes",
      "name": "Get Homes",
      "params": [],
      "headers": [
        {
          "key": "Authorization",
          "value": "Bearer <<ACCESS_TOKEN>>",
          "active": true
        }
      ],
      "method": "GET",
      "auth": {
        "authType": "none",
        "authActive": true
      },
      "preRequestScript": "",
      "testScript": "",
      "body": {
        "contentType": null,
        "body": null
      },
      "description": "Fetches homes for the authenticated user."
    }
  ],
  "auth": {
    "authType": "none",
    "authActive": true
  },
  "headers": []
}
