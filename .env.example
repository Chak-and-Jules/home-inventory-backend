PORT=8080
FIREBASE_PROJECT_ID=home-inventory-11
GCS_BUCKET_NAME=home-inventory-11-images
# Cloud Run discovers its signer automatically. For local ADC, set the runtime
# service account email and grant your local identity signBlob on that account.
# GCS_SIGNER_EMAIL=your-runtime-service-account@home-inventory-11.iam.gserviceaccount.com
# Cloud Run uses its runtime service account through Application Default Credentials.
# Locally: gcloud auth application-default login
DB_HOST=/cloudsql/home-inventory-11:us-central1:home-inventory-db
DB_USER=home_inventory_app
DB_PASSWORD=your_db_password_here
DB_NAME=home_inventory
DB_PORT=5432

# APP_ENV defaults to production. Only local development may use the Auth emulator.
APP_ENV=local
